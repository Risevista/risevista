---
// pages/mission.astro
import Layout from '../layouts/Layout.astro';
import Image from '../components/Image.astro';
import Values from '../components/Values.astro';
import President from '../assets/img/president.webp';
import Consultant1 from '../assets/img/member2.webp';
import SectionTitle from '../components/SectionTitle.astro';
---

<Layout title="Mission | 株式会社RISE VISTA">
  <main class="bg-primary-back text-primary font-inter leading-relaxed">
    <!-- MISSION 見出し -->
    <section class="w-full flex flex-col items-center bg-primary-back text-primary pt-24 md:pt-48 pb-12 md:pb-24 relative" id="mission">
      <div class="section-heading">MISSION</div>
      <div class="w-full max-w-6xl mx-auto px-4 flex flex-col gap-8">
        <SectionTitle title="MISSION" subtitle="ミッション" />
        <!-- Content Section -->
        <div class="flex flex-col items-start justify-center">
          <h3 class="text-2xl md:text-4xl font-serif font-normal leading-tight mb-6 slide-in-left" style="--delay: 0.2s;">一人ひとりの力を信じ、<br/>革新と創造を通じて<br/>人生１００年時代を支えるパートナーに</h3>
          <p class="text-[16px] leading-relaxed mb-0 font-serif slide-in-left" style="--delay: 0.4s;">
            人生１００年時代を迎え、将来に向けた資産形成や運用の重要性はこれまで以上に高まっています。かつての「貯蓄から投資へ」という流れは、今や個人のライフスタイルに合わせた柔軟で多様な資産運用へと進化しています。私たちは、一人ひとりが自分らしい未来を描けるよう、革新と創造を通じて人生１００年時代を支えるパートナーになります。
          </p>
        </div>
      </div>
    </section>
    <!-- VALUES セクション -->
    <Values />

<!-- PURPOSE セクション -->
<section class="w-full flex flex-col items-center bg-primary-back text-primary py-16 md:py-24 relative" id="purpose">
  <div class="section-heading">PURPOSE</div>
  <div class="w-full max-w-6xl mx-auto px-4 flex flex-col gap-8">
    <!-- Title Section -->
    <SectionTitle title="PURPOSE" subtitle="パーパス" />
    <!-- Content Section -->
    <div class="flex flex-col items-start justify-center">
      <h3 class="text-2xl md:text-4xl font-serif font-normal leading-tight mb-6 slide-in-left" style="--delay: 0.2s;">日本に健全な投資文化を育み<br/>豊かさと成長を次世代へ</h3>
      <p class="text-[16px] leading-relaxed mb-6 font-serif slide-in-left" style="--delay: 0.4s;">
        私たちは、「不動産」という枠組みを超えて、未来を創る力になりたいと考えています。一人ひとりの暮らしから、地域、そして日本の未来を変えていく。健全な投資文化を日本に根付かせ、次世代に豊かさと成長を継承することが私たちの使命です。
      </p>
    </div>
  </div>
</section>

  <section class="w-full flex flex-col items-center bg-primary-back text-primary py-16 md:py-24 relative" id="message">
      <div class="section-heading">MESSAGE</div>
      <div class="w-full max-w-6xl mx-auto px-4 flex flex-col gap-8">
        <SectionTitle title="MESSAGE" subtitle="代表挨拶" />
        <!-- Content with two columns -->
        <div class="w-full flex flex-col md:flex-row gap-8 md:gap-12">
          <!-- Right Image (モバイルでは最初に表示) -->
          <div class="flex-1 flex justify-center items-center order-1 md:order-2">
            <Image src={President} alt="代表者" class="w-64 h-64 md:w-80 md:h-80 object-cover rounded-lg shadow-lg" />
          </div>
          <!-- Left Content (モバイルでは2番目に表示) -->
          <div class="flex-1 flex flex-col items-start justify-center order-2 md:order-1">
            <h3 class="text-2xl md:text-4xl font-serif font-normal leading-tight mb-6 slide-in-left" style="--delay: 0.2s;">お客様一人ひとりの<br/>未来を創造するパートナーとして</h3>
            <p class="mb-6 md:text-[16px] font-serif">
              はじめまして。代表取締役の土屋健二と申します。<br>RISE VISTAは、「不動産投資を通じて、お客様一人ひとりの未来を共に創造するパートナーでありたい」という想いを胸に、日々挑戦を続けています。<br><br>私はこれまで、数多くの投資家・オーナー様と真剣に向き合ってきました。そこで強く感じたのは、
              資産形成に“絶対の正解”はないということです。だからこそRISE VISTAでは、誰かの成功事例をなぞるのではなく、お客様一人ひとりの目標・価値観・リスク許容度に合わせた“完全オーダーメイド”のプランニングを大切にしています。<br><br>人生100年時代を迎え、資産形成の在り方は多様化し、より長期的な視点が求められています。私たちは、物件選定やファイナンスだけでなく、運用・管理・税務・相続までを一気通貫で支援することで、お客様が将来にわたって安心できる体制を整えています。誠実さ・透明性・信頼。この3つを軸に、長く寄り添えるパートナーとして歩み続けます。<br><br>RISE VISTAは、単に「資産を増やすための会社」ではありません。私たちは、お客様が思い描く“理想の未来”を共に実現する人生の伴走者でありたいのです。不動産投資を通じて、お客様の人生をより豊かに、そして力強く支える存在であり続けることをお約束します。今後ともどうぞよろしくお願いいたします。
            </p>
            <div class="w-full mt-8 flex flex-col items-end">
              <p class="text-[16px] font-serif">代表取締役</p>
              <p class="text-[16px] font-serif">土屋 健二</p>
            </div>
          </div>
        </div>
      </div>
    </section>
    
    <section class="w-full flex flex-col items-center bg-primary-back text-primary py-20 md:py-24 relative" id="consultants">
      <div class="section-heading">CONSULTANTS</div>
      <div class="w-full max-w-6xl mx-auto px-4 flex flex-col gap-8">
        <SectionTitle title="CONSULTANTS" subtitle="コンサルタント紹介" />
        <!-- Content with two columns -->
        <div class="w-full flex flex-col md:flex-row gap-8 md:gap-12">
          <!-- Right Image (モバイルでは最初に表示) -->
          <div class="flex-1 flex justify-center items-center order-1 md:order-2">
            <Image src={Consultant1} alt="consultant" class="w-64 h-64 md:w-80 md:h-80 object-cover rounded-lg shadow-lg" />
          </div>
          <!-- Left Content (モバイルでは2番目に表示) -->
          <div class="flex-1 flex flex-col items-start justify-center order-2 md:order-1">
            <p class="mb-6 md:text-[16px] font-serif;">
              横浜高校野球部出身。2008年、甲子園ベスト4を経験。全国の舞台で学んだ「挑戦を恐れない心」と「仲間を信じてやり抜く力」は、今も私の行動の原動力です。<br><br>高校卒業後は専修大学へ進学。卒業後は食品メーカーで社会人としての基礎を築き、その後、介護・福祉業界へ転身。高級老人ホームにて20代でマネージャーを任され、組織運営・人材育成・サービス品質の向上に携わりました。<br><br>常に「人を想い、人を動かす」ことを大切にしながら、チーム一丸となって成果を出す喜びを実感してきました。10年にわたる介護・福祉業界での経験を経て、「自分自身のさらなる成長」「家族や仲間の幸せ」「関わるすべての人に良い影響を与えたい」という強い想いから、新たな挑戦として株式会社RISE VISTAへ参画しました。<br><br>これまで培った人間力・リーダーシップ・マネジメント力を活かし、どんな状況でも前を向き、周囲を巻き込みながら挑戦を続けていきます。信頼されるリーダーとして、チームとともに新たな価値を創造し、RISE VISTAの成長を牽引してまいります
            </p>
            <div class="w-full mt-8 flex flex-col items-end">
              <p class="text-[16px] font-serif">役員</p>
              <p class="text-[16px] font-serif">髙橋 亮輔</p>
            </div>
          </div>
        </div>
      </div>
    </section>

  </main>
</Layout>

<style>
/* Fade in text animation */
.fade-in-text {
  opacity: 0;
  transform: translateY(20px);
  transition: opacity 0.8s ease-out, transform 0.8s ease-out;
  transition-delay: var(--delay, 0s);
  display: inline-block;
}

.fade-in-text.visible {
  opacity: 1;
  transform: translateY(0);
}

/* Slide in left animation */
.slide-in-left {
  left: -60px;
  opacity: 0;
  transform: skewX(-5deg);
  transition: opacity 1s ease-out, transform 1.5s, left 1.5s;
  transition-delay: var(--delay, 0s);
  position: relative;
}

.slide-in-left.visible {
  left: 0;
  opacity: 1;
  transform: skewX(0);
}

/* Slide in right animation */
.slide-in-right {
  right: -60px;
  opacity: 0;
  transform: skewX(5deg);
  transition: opacity 1s ease-out, transform 1.5s, right 1.5s;
  transition-delay: var(--delay, 0s);
  position: relative;
}

.slide-in-right.visible {
  right: 0;
  opacity: 1;
  transform: skewX(0);
}
.section__largeText {
  position: absolute;
  left: 3.75rem;         /* スクショでは 3.75rem 付近 */
  bottom: 8.5rem;        /* 下からのオフセット */
  font-size: 8.75rem;    /* 端末幅でメディアクエリ上書きあり */
  line-height: 0.93;
  opacity: .1;
  pointer-events: none;  /* 触れない装飾扱い */
}
@media (max-width: 767px) {
  .section__largeText {
    left: 2rem;
    bottom: 5rem;
    font-size: 5rem;
  }
}

.section-heading {
  position: absolute;
  bottom: 2rem;
  right: 2rem;
  font-size: 8rem;
  font-weight: bold;
  color: #00502f;
  opacity: 0.1;
  pointer-events: none;
  z-index: 1;
  letter-spacing: 0.2em;
}

@media (max-width: 767px) {
  .section-heading {
    bottom: 2rem;
    right: 1rem;
    font-size: 2.25rem;
  }
  
  /* スマホでのスクロール時のオフセット調整 */
  #message, #consultants {
    scroll-margin-top: 80px;
  }
}

</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    }, {
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px'
    });

    document.querySelectorAll('.fade-in-text').forEach((el) => {
      observer.observe(el);
    });

    // Handle slide-in-left animation
    const slideInLeftObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        } else {
          entry.target.classList.remove('visible');
        }
      });
    }, {
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px'
    });

    document.querySelectorAll('.slide-in-left').forEach((el) => {
      slideInLeftObserver.observe(el);
    });

    // Handle slide-in-right animation
    const slideInRightObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        } else {
          entry.target.classList.remove('visible');
        }
      });
    }, {
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px'
    });

    document.querySelectorAll('.slide-in-right').forEach((el) => {
      slideInRightObserver.observe(el);
    });
  });
</script>
